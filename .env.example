# ══════════════════════════════════════════════════════════════════
# НАСТРОЙКИ ДЛЯ ВАШЕГО СЕРВЕРА И ДОМЕНА
#
# 1. Скопируйте этот файл:   cp .env.example .env
# 2. Впишите свои значения ниже
# 3. Запустите:              docker compose up -d --build
#
# Файл .env НИКОГДА не выкладывайте в открытый доступ (в нём пароли).
# ══════════════════════════════════════════════════════════════════

# ─── ВАШ ДОМЕН ────────────────────────────────────────────────────
# Замените olanhightech.com на свой домен.
# В DNS нужно создать четыре записи типа A на IP вашего сервера:
#   olanhightech.com        → IP
#   www.olanhightech.com    → IP
#   portal.olanhightech.com → IP   (кабинеты сотрудников)
#   admin.olanhightech.com  → IP   (админ-панель)
#   api.olanhightech.com    → IP   (сервер и чат)

DOMAIN=olanhightech.com
PORTAL_DOMAIN=portal.olanhightech.com
ADMIN_DOMAIN=admin.olanhightech.com
API_DOMAIN=api.olanhightech.com

# Адрес сервера, который будут использовать все три сайта
VITE_API_URL=https://api.olanhightech.com

# Почта для выпуска бесплатного SSL-сертификата Let's Encrypt
CERTBOT_EMAIL=admin@olanhightech.com


# ─── ДОСТУП АДМИНИСТРАТОРА ────────────────────────────────────────
# ⚠️ ОБЯЗАТЕЛЬНО поменяйте перед запуском!
ADMIN_EMAIL=admin@olanhightech.com
ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СЛОЖНЫЙ_ПАРОЛЬ

# Секретный ключ для входов. Сгенерируйте длинную случайную строку:
#   openssl rand -hex 32
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_НЕ_МЕНЕЕ_32_СИМВОЛОВ


# ─── СЕРВЕР ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# Кому разрешено обращаться к серверу (через запятую, без пробелов)
ALLOWED_ORIGINS=https://olanhightech.com,https://www.olanhightech.com,https://portal.olanhightech.com,https://admin.olanhightech.com


# ─── АВТОМАТИЧЕСКИЙ ПЕРЕВОД САЙТА ─────────────────────────────────
# google-free — БЕСПЛАТНЫЙ переводчик Google без ключа (по умолчанию).
#          Переводит все 9 языков, нужен только интернет.
# none   — без перевода: текст копируется на все 9 языков,
#          переводы правятся вручную в админ-панели
# libre  — LibreTranslate: бесплатный, поднимается рядом в docker compose
#          (раскомментируйте службу libretranslate в docker-compose.yml)
# google — Google Cloud Translation (нужен ключ)
# deepl  — DeepL (нужен ключ, лучшее качество для EN/DE/ZH)

TRANSLATE_PROVIDER=google-free
TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=http://libretranslate:5000
