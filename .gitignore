# ══════════════════════════════════════════════════════════════════
# ЧТО НЕ ПОПАДАЕТ В GITHUB
# Важно: здесь перечислено всё, что нельзя публиковать —
# пароли, база с перепиской, загруженные файлы.
# ══════════════════════════════════════════════════════════════════

# Библиотеки (Netlify скачает их сам при сборке)
node_modules/

# Готовые сборки (Netlify собирает заново)
dist/
build/

# ⚠️ ПАРОЛИ И НАСТРОЙКИ СЕРВЕРА — публиковать нельзя!
.env
.env.local
.env.production

# ⚠️ БАЗА ДАННЫХ: сотрудники, переписка с клиентами, заявки
server/data/

# Загруженные логотипы партнёров
server/uploads/*
!server/uploads/.gitkeep

# Резервные копии
backups/
*.tar.gz
*.zip

# Логи
logs/
*.log
npm-debug.log*

# Служебные файлы систем
.DS_Store
Thumbs.db

# Файлы редакторов
.idea/
*.swp
